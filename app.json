{
  "expo": {
    "name": "Powerform",
    "slug": "Powerform",
    "scheme": "powerform",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0F14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Powerform"
    },
    "android": {
      "package": "com.powerform.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-image",
      "expo-localization",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4725502493968424~2793788449",
          "iosAppId": "ca-app-pub-3940256099942544~1458602516"
        }
      ]
    ]
  }
}
